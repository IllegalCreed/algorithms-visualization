{
  "name": "algorithms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "audit": "pnpm audit --audit-level=moderate",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "build-only": "vite build && node scripts/prerender.mjs --mode production && node scripts/verify-seo.mjs --mode production && node scripts/verify-bundle.mjs && cp 404.html dist/",
    "build:selfhost": "vite build --mode selfhost && node scripts/prerender.mjs --mode selfhost && node scripts/verify-seo.mjs --mode selfhost && node scripts/verify-bundle.mjs && cp 404.html dist/",
    "prerender": "node scripts/prerender.mjs --mode production",
    "verify:seo": "node scripts/verify-seo.mjs --mode production",
    "marketing:link": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/generate-campaign-link.ts",
    "marketing:dry-run": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/marketing/dry-run.ts",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write src/ scripts/ docs/ e2e/ public/ .github/workflows/ '*.html' '*.json' '*.md' '*.ts' .prettierrc.json --ignore-unknown",
    "format:check": "prettier --check src/ scripts/ docs/ e2e/ public/ .github/workflows/ '*.html' '*.json' '*.md' '*.ts' .prettierrc.json --ignore-unknown",
    "verify": "run-s format:check lint:check type-check test:unit:run build-only",
    "prepare": "husky"
  },
  "dependencies": {
    "@shikijs/langs": "^4.4.2",
    "@shikijs/themes": "^4.4.2",
    "pinia": "^3.0.4",
    "shiki": "^4.4.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tsconfig/node20": "^20.1.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "less": "^4.8.1",
    "lint-staged": "^17.3.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.8.4",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{ts,mts,tsx,vue,js,mjs}": "eslint --fix",
    "*.{ts,mts,tsx,vue,js,mjs,json,md,less,css,html}": "prettier --write"
  }
}
